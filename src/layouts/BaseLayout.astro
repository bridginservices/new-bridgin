---
// Base layout — <head>, fonts, nav, footer, and global scroll reveals.
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Hero pages start with a transparent header over dark imagery. */
  transparentHeader?: boolean;
}
const { title, description, ogImage, type, noindex } = Astro.props;
---
<!doctype html>
<html lang="en" class="no-js scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts: Space Grotesk (headings) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <SEO title={title} description={description} ogImage={ogImage} type={type} noindex={noindex} />

    <!-- Swap no-js -> js as early as possible for progressive enhancement -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>

    <!-- JSON-LD organization schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: "bRIDGIN' Marketing Services",
      description: description,
      url: Astro.site?.href,
      areaServed: 'IN',
      sameAs: [
        'https://www.linkedin.com/company/bridgin-marketing/',
        'https://www.instagram.com/bridgin__marketing',
        'https://www.facebook.com/share/1Gaf5nYbwR/',
      ],
    })} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-cyan focus:px-4 focus:py-2 focus:font-semibold focus:text-ink-950"
    >
      Skip to content
    </a>

    <Navbar />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <WhatsAppButton />

    <!-- Global motion engine — scroll reveals, directional/scale variants,
         and subtle decorative parallax. Follows the ui-ux-pro-max GSAP
         motion presets: transform/opacity only, scoped ScrollTriggers,
         and full reduced-motion opt-out. -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

      if (reduce) {
        // Reduced motion: show everything instantly, no transforms.
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        gsap.registerPlugin(ScrollTrigger);

        // The from-state per reveal variant (preset #4 fade/slide, #8 scale).
        const fromVars = (v: string): gsap.TweenVars => {
          switch (v) {
            case 'fade':  return { opacity: 0 };
            case 'left':  return { opacity: 0, x: -48 };
            case 'right': return { opacity: 0, x: 48 };
            case 'scale': return { opacity: 0, scale: 0.94, y: 18 };
            case 'up':
            default:      return { opacity: 0, y: 28 };
          }
        };

        revealEls.forEach((el) => {
          const variant = el.dataset.reveal || 'up';
          const delay = parseFloat(el.dataset.delay || '0');
          gsap.set(el, fromVars(variant));
          ScrollTrigger.create({
            trigger: el,
            start: 'top 88%',
            once: true,
            onEnter: () =>
              gsap.to(el, {
                opacity: 1,
                x: 0,
                y: 0,
                scale: 1,
                duration: variant === 'scale' ? 0.6 : 0.7,
                delay,
                ease: variant === 'scale' ? 'back.out(1.4)' : 'power2.out',
                clearProps: 'transform',
                onStart: () => el.classList.add('is-visible'),
              }),
          });
        });

        // Decorative parallax (preset #13, subtle) — background/glow layers only.
        gsap.utils.toArray<HTMLElement>('[data-parallax]').forEach((layer) => {
          const strength = parseFloat(layer.dataset.parallax || '12');
          // GSAP owns transform, so re-apply horizontal centering for layers
          // that were centered via Tailwind's -translate-x-1/2.
          if (layer.dataset.parallaxCx !== undefined) gsap.set(layer, { xPercent: -50 });
          gsap.to(layer, {
            yPercent: strength,
            ease: 'none',
            scrollTrigger: {
              trigger: layer.parentElement || layer,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 0.6,
            },
          });
        });

        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        // ── Signature FX #1: cursor spotlight / aurora ───────────────────
        const spot = document.createElement('div');
        spot.className = 'cursor-spot';
        document.body.appendChild(spot);
        gsap.set(spot, { xPercent: -50, yPercent: -50 });
        if (finePointer) {
          const sx = gsap.quickTo(spot, 'x', { duration: 0.5, ease: 'power3.out' });
          const sy = gsap.quickTo(spot, 'y', { duration: 0.5, ease: 'power3.out' });
          window.addEventListener(
            'pointermove',
            (e) => {
              sx(e.clientX);
              sy(e.clientY);
              spot.style.opacity = '1';
            },
            { passive: true }
          );
          document.addEventListener('mouseleave', () => (spot.style.opacity = '0'));
        } else {
          // Touch / coarse pointer: a slow drifting aurora instead.
          gsap.set(spot, { x: window.innerWidth * 0.5, y: window.innerHeight * 0.35, opacity: 0.6 });
          gsap.to(spot, {
            x: () => window.innerWidth * (0.3 + Math.random() * 0.4),
            y: () => window.innerHeight * (0.25 + Math.random() * 0.4),
            duration: 8,
            ease: 'sine.inOut',
            repeat: -1,
            yoyo: true,
            repeatRefresh: true,
          });
        }

        if (finePointer) {
          // ── Signature FX #2a: magnetic primary CTAs (preset #3) ────────
          gsap.utils.toArray<HTMLElement>('.btn-primary').forEach((btn) => {
            // Let GSAP fully own transform; keep colour/shadow transitions.
            btn.style.transition = 'color .3s, background-color .3s, box-shadow .3s, filter .3s';
            const mx = gsap.quickTo(btn, 'x', { duration: 0.4, ease: 'elastic.out(1, 0.4)' });
            const my = gsap.quickTo(btn, 'y', { duration: 0.4, ease: 'elastic.out(1, 0.4)' });
            btn.addEventListener('pointermove', (e) => {
              const r = btn.getBoundingClientRect();
              mx((e.clientX - r.left - r.width / 2) * 0.35);
              my((e.clientY - r.top - r.height / 2) * 0.6);
            });
            btn.addEventListener('pointerleave', () => {
              mx(0);
              my(0);
            });
          });

          // ── Signature FX #2b: 3D tilt + glare on cards ─────────────────
          gsap.utils.toArray<HTMLElement>('.surface-hover').forEach((card) => {
            const glare = document.createElement('span');
            glare.className = 'card-glare';
            card.appendChild(glare);
            const rx = gsap.quickTo(card, 'rotationX', { duration: 0.4, ease: 'power2.out' });
            const ry = gsap.quickTo(card, 'rotationY', { duration: 0.4, ease: 'power2.out' });
            card.addEventListener('pointerenter', () =>
              gsap.set(card, { transformPerspective: 900, transformStyle: 'preserve-3d' })
            );
            card.addEventListener('pointermove', (e) => {
              const r = card.getBoundingClientRect();
              const px = (e.clientX - r.left) / r.width;
              const py = (e.clientY - r.top) / r.height;
              ry((px - 0.5) * 9);
              rx((0.5 - py) * 9);
              glare.style.setProperty('--gx', px * 100 + '%');
              glare.style.setProperty('--gy', py * 100 + '%');
              glare.style.opacity = '1';
            });
            card.addEventListener('pointerleave', () => {
              rx(0);
              ry(0);
              glare.style.opacity = '0';
            });
          });
        }

        // ── Signature FX #3: cyber text decode reveal ────────────────────
        const glyphs = '!<>-_\\/[]{}—=+*^?#01ABCDEF';
        const decodeEl = (el: HTMLElement) => {
          if (el.childElementCount > 0) return; // never scramble elements with markup
          const text = el.textContent || '';
          const len = text.length;
          const total = Math.min(30, 12 + len);
          let frame = 0;
          const tick = () => {
            const revealed = Math.floor((frame / total) * len);
            let out = '';
            for (let i = 0; i < len; i++) {
              if (text[i] === ' ') out += ' ';
              else if (i < revealed) out += text[i];
              else out += glyphs[(Math.random() * glyphs.length) | 0];
            }
            el.textContent = out;
            if (frame++ <= total) requestAnimationFrame(tick);
            else el.textContent = text;
          };
          tick();
        };
        gsap.utils.toArray<HTMLElement>('[data-decode]').forEach((el) => {
          ScrollTrigger.create({
            trigger: el,
            start: 'top 90%',
            once: true,
            onEnter: () => decodeEl(el),
          });
        });
      }
    </script>
  </body>
</html>
