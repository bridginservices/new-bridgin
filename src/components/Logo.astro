---
// bRIDGIN' logo lockup — official "b'" mark (public/logo-mark.png,
// transparent PNG supplied by the brand) + wordmark in brand blue.
interface Props {
  class?: string;
  /** Show only the mark (no wordmark text). */
  markOnly?: boolean;
}
const { class: className = '', markOnly = false } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 font-heading font-bold ${className}`} aria-label="bRIDGIN' Marketing Services home">
  <!-- Official b' mark (transparent) -->
  <img
    src="/logo-mark.png"
    alt="bRIDGIN'"
    width="146"
    height="240"
    class="h-7 w-auto"
    loading="eager"
    decoding="async"
  />
  {!markOnly && (
    <span class="text-xl tracking-tight text-white">
      b<span class="text-[#37C1F0]">RIDGIN</span><span class="text-[#37C1F0]">'</span>
    </span>
  )}
</span>
