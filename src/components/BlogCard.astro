---
import { Image } from 'astro:assets';
import { img } from '../utils/images.js';
import Icon from './Icon.astro';
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      image: string;
      imageAlt: string;
      readTime: string;
      placeholder?: boolean;
    };
  };
  index?: number;
}
const { post, index = 0 } = Astro.props;
const { data } = post;
const dateStr = data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---
<article class="reveal group surface overflow-hidden surface-hover flex flex-col" data-reveal="scale" data-delay={(index % 3) * 0.08}>
  <a href={`/blogs/${post.id}`} class="block">
    <figure class="relative m-0 aspect-[16/9] overflow-hidden">
      <Image
        src={img(data.image)}
        alt={data.imageAlt}
        title={data.title}
        widths={[480, 800]}
        sizes="(max-width: 768px) 100vw, 33vw"
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      {data.placeholder && (
        <span class="absolute right-3 top-3 rounded-full bg-white/10 px-2 py-0.5 text-[10px] uppercase tracking-wider text-white/60">Placeholder</span>
      )}
    </figure>
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center gap-3 text-xs text-white/50">
      <span>{dateStr}</span>
      <span class="inline-flex items-center gap-1"><Icon name="clock" class="h-3.5 w-3.5" /> {data.readTime}</span>
    </div>
    <h3 class="mt-3 text-lg font-semibold leading-snug text-white group-hover:text-cyan">
      <a href={`/blogs/${post.id}`}>{data.title}</a>
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-white/60">{data.description}</p>
    <a href={`/blogs/${post.id}`} class="group/read mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-cyan/80 transition-colors hover:text-cyan">
      Read article
      <Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover/read:translate-x-1" />
    </a>
  </div>
</article>
