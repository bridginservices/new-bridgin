---
interface Props {
  rating?: number;
  class?: string;
}
const { rating = 5, class: className = '' } = Astro.props;
---
<div class:list={['flex gap-0.5', className]} role="img" aria-label={`${rating} out of 5 stars`}>
  {
    Array.from({ length: 5 }).map((_, i) => (
      <svg
        class:list={['h-4 w-4', i < rating ? 'text-cyan' : 'text-white/20']}
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 2l3.1 6.6 6.9.9-5 4.9 1.2 7L12 18.1 5.8 21.4 7 14.4l-5-4.9 6.9-.9L12 2z" />
      </svg>
    ))
  }
</div>
