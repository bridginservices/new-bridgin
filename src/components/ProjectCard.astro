---
import { Image } from 'astro:assets';
import { img } from '../utils/images.js';
import Icon from './Icon.astro';
interface Props {
  project: {
    client: string;
    category: string;
    image: string;
    alt: string;
    title: string;
    services: string[];
    result: string;
    metric: string;
    placeholder?: boolean;
  };
  index?: number;
}
const { project, index = 0 } = Astro.props;
---
<article class="reveal group surface overflow-hidden surface-hover" data-delay={(index % 2) * 0.1}>
  <figure class="relative m-0 aspect-[16/10] overflow-hidden">
    <Image
      src={img(project.image)}
      alt={project.alt}
      title={project.title}
      widths={[480, 800]}
      sizes="(max-width: 768px) 100vw, 50vw"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/30 to-transparent"></div>
    <span class="absolute left-4 top-4 rounded-full border border-cyan/30 bg-ink-950/70 px-3 py-1 text-xs text-cyan">
      {project.category}
    </span>
    {project.placeholder && (
      <span class="absolute right-4 top-4 rounded-full bg-white/10 px-2.5 py-0.5 text-[10px] uppercase tracking-wider text-white/60" title="Placeholder image — replace with real project screenshot">
        Placeholder
      </span>
    )}
    <figcaption class="sr-only">{project.title}</figcaption>
  </figure>

  <div class="p-6">
    <div class="flex items-center justify-between">
      <h3 class="text-xl font-semibold text-white group-hover:text-cyan">{project.client}</h3>
      <span class="inline-flex items-center gap-1 text-xs font-semibold text-cyan">
        <Icon name="chart" class="h-4 w-4" /> {project.metric}
      </span>
    </div>
    <p class="mt-3 text-sm leading-relaxed text-white/65">{project.result}</p>
    <div class="mt-4 flex flex-wrap gap-1.5">
      {project.services.map((s) => (
        <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-[11px] text-white/70">{s}</span>
      ))}
    </div>
  </div>
</article>
