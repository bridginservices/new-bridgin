---
// Signature rotating 3D services wheel (spec §4.3).
// Desktop: CSS 3D transform carousel, auto-rotating, active panel
// pops to front in cyan; prev/next + dot controls; pause on hover.
// Mobile: Swiper coverflow carousel with the same auto-rotate +
// cyan-active behaviour. Every service name links to its page.
import { services } from '../data/services.js';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---
<section id="services" class="section-y relative overflow-hidden bg-ink-950">
  <!-- Animated grid + radial glow backdrop -->
  <div class="pointer-events-none absolute inset-0 cyber-grid opacity-40 animate-gridDrift"></div>
  <div class="glow-blob pointer-events-none absolute left-1/2 top-1/2 h-[520px] w-[520px] -translate-x-1/2 -translate-y-1/2"></div>

  <div class="container-x relative">
    <SectionHeading
      eyebrow="What We Do"
      title="Ten Services. One Growth Engine."
      subtitle="A full-funnel toolkit — spin through everything we do to bridge your business to digital success."
      center
    />

    <!-- Desktop 3D wheel -->
    <div
      class="wheel-outer relative mt-8 hidden md:block"
      data-wheel
      aria-roledescription="carousel"
      aria-label="bRIDGIN' services"
    >
      <div class="wheel-stage">
        <div class="wheel" data-wheel-track>
          {
            services.map((s, i) => (
              <div class="wheel-panel" style={`--idx:${i}`} data-panel data-index={i}>
                <a href={`/services/${s.slug}`} class="panel-card" data-num={String(i + 1).padStart(2, '0')} aria-label={`${s.name} — view service`}>
                  <span class="panel-icon">
                    <Icon name={s.icon} class="h-9 w-9" />
                  </span>
                  <span class="panel-num">Service {String(i + 1).padStart(2, '0')}</span>
                  <h3 class="panel-title">{s.name}</h3>
                  <p class="panel-tagline">{s.tagline}</p>
                  <span class="panel-cta">Explore <Icon name="arrow" class="h-3.5 w-3.5" /></span>
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Prev / Next -->
      <button class="wheel-arrow left-0" data-prev aria-label="Previous service">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="wheel-arrow right-0" data-next aria-label="Next service">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <!-- Dots -->
      <div class="mt-6 flex flex-wrap justify-center gap-2" data-dots role="tablist" aria-label="Select a service">
        {
          services.map((s, i) => (
            <button class="wheel-dot" data-dot data-index={i} role="tab" aria-label={s.name} aria-selected={i === 0 ? 'true' : 'false'}></button>
          ))
        }
      </div>
    </div>

    <!-- Mobile carousel -->
    <div class="mt-8 md:hidden">
      <div class="swiper services-swiper !overflow-visible">
        <div class="swiper-wrapper">
          {
            services.map((s, i) => (
              <div class="swiper-slide">
                <a href={`/services/${s.slug}`} class="panel-card panel-card--mobile" data-num={String(i + 1).padStart(2, '0')}>
                  <span class="panel-icon"><Icon name={s.icon} class="h-9 w-9" /></span>
                  <span class="panel-num">Service {String(i + 1).padStart(2, '0')}</span>
                  <h3 class="panel-title">{s.name}</h3>
                  <p class="panel-tagline">{s.tagline}</p>
                  <span class="panel-cta">Explore <Icon name="arrow" class="h-3.5 w-3.5" /></span>
                </a>
              </div>
            ))
          }
        </div>
        <div class="services-pagination mt-6 flex justify-center gap-2"></div>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a href="/services" class="btn-outline">View All Services</a>
    </div>
  </div>
</section>

<style>
  /* ---------- 3D wheel ---------- */
  .wheel-stage {
    position: relative;
    height: 360px;
    perspective: 1200px;
    margin: 0 auto;
  }
  /* Rotating glow halo behind the wheel (the "orbit") */
  .wheel-stage::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 360px;
    height: 360px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      rgba(55, 193, 240, 0.35),
      transparent 30%,
      rgba(55, 193, 240, 0.12) 55%,
      transparent 80%,
      rgba(55, 193, 240, 0.35)
    );
    filter: blur(34px);
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
    animation: orbitSpin 16s linear infinite;
  }
  /* Faint static ring to reinforce the orbit */
  .wheel-stage::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 300px;
    height: 300px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px dashed rgba(55, 193, 240, 0.18);
    pointer-events: none;
    z-index: 0;
  }
  @keyframes orbitSpin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
  .wheel {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 260px;
    height: 300px;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .wheel-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 260px;
    height: 300px;
    /* --radius set from JS; arrange each panel around the circle */
    transform: rotateY(calc(var(--idx) * var(--step, 36deg)))
      translateZ(var(--radius, 420px));
    transition: opacity 0.5s ease, filter 0.5s ease;
    opacity: 0.28;
    filter: brightness(0.5) blur(2px);
  }
  .wheel-panel:not(.is-active) {
    pointer-events: none;
  }
  .wheel-panel.is-active {
    opacity: 1;
    filter: brightness(1) blur(0);
    z-index: 5;
  }

  .panel-card {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(130% 120% at 0% 0%, rgba(55, 193, 240, 0.10), transparent 55%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
    padding: 1.9rem 1.75rem;
    overflow: hidden;
    backdrop-filter: blur(8px);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s ease,
      box-shadow 0.4s ease, background 0.4s ease;
  }
  /* Large ghost numeral in the corner */
  .panel-card::after {
    content: attr(data-num);
    position: absolute;
    right: -0.4rem;
    bottom: -1.6rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 6.5rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.05);
    transition: color 0.4s ease;
    pointer-events: none;
  }
  .is-active .panel-card::after { color: rgba(55, 193, 240, 0.14); }
  /* Glowing gradient border, revealed on active */
  .panel-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgba(55, 193, 240, 0.9), transparent 45%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .is-active .panel-card::before { opacity: 1; }
  .is-active .panel-card {
    transform: scale(1.08) translateY(-4px);
    border-color: rgba(55, 193, 240, 0.55);
    background:
      radial-gradient(130% 120% at 50% 0%, rgba(55, 193, 240, 0.18), transparent 60%),
      linear-gradient(160deg, rgba(55, 193, 240, 0.10), rgba(255, 255, 255, 0.02));
    box-shadow: 0 24px 60px -18px rgba(0, 0, 0, 0.7), 0 0 55px rgba(55, 193, 240, 0.35);
  }
  .panel-icon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    height: 3.25rem;
    width: 3.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    color: #37C1F0;
    background: rgba(55, 193, 240, 0.08);
    border: 1px solid rgba(55, 193, 240, 0.22);
    box-shadow: inset 0 0 14px rgba(55, 193, 240, 0.12);
    transition: background 0.4s ease, box-shadow 0.4s ease, transform 0.4s ease;
  }
  .is-active .panel-icon {
    background: rgba(55, 193, 240, 0.18);
    box-shadow: 0 0 22px rgba(55, 193, 240, 0.4);
    animation: iconPop 0.6s ease;
  }
  @keyframes iconPop {
    0% { transform: scale(0.6) rotate(-8deg); opacity: 0; }
    100% { transform: scale(1) rotate(0); opacity: 1; }
  }
  .panel-num {
    position: relative;
    z-index: 1;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(55, 193, 240, 0.7);
  }
  .panel-title {
    position: relative;
    z-index: 1;
    margin-top: auto;
    font-size: 1.4rem;
    line-height: 1.15;
    color: #fff;
    transition: color 0.4s ease;
  }
  .is-active .panel-title { color: #37C1F0; }
  .panel-tagline {
    position: relative;
    z-index: 1;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
  }
  .panel-cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #37C1F0;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.35s ease, transform 0.35s ease, gap 0.25s ease;
  }
  .is-active .panel-cta { opacity: 1; transform: translateX(0); }
  .panel-card:hover .panel-cta { gap: 0.7rem; }

  /* ---------- Arrows & dots ---------- */
  .wheel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    height: 48px;
    width: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(55, 193, 240, 0.4);
    background: rgba(10, 10, 10, 0.7);
    color: #37C1F0;
    transition: all 0.25s ease;
  }
  .wheel-arrow:hover {
    background: #37C1F0;
    color: #0a0a0a;
    box-shadow: 0 0 20px rgba(55, 193, 240, 0.5);
  }
  .wheel-dot {
    height: 8px;
    width: 8px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.25);
    transition: all 0.3s ease;
  }
  .wheel-dot[aria-selected='true'] {
    width: 26px;
    background: #37C1F0;
    box-shadow: 0 0 10px rgba(55, 193, 240, 0.6);
  }

  /* ---------- Mobile cards ---------- */
  .panel-card--mobile {
    height: 260px;
    opacity: 0.6;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .services-swiper :global(.swiper-slide-active) .panel-card--mobile {
    opacity: 1;
    border-color: rgba(55, 193, 240, 0.6);
    box-shadow: 0 0 30px rgba(55, 193, 240, 0.3);
  }
  .services-swiper :global(.swiper-slide-active) .panel-title { color: #37C1F0; }
  .services-pagination :global(.swiper-pagination-bullet) {
    width: 8px; height: 8px; background: rgba(255,255,255,0.25); opacity: 1; border-radius: 9999px; transition: all .3s ease;
  }
  .services-pagination :global(.swiper-pagination-bullet-active) {
    width: 26px; background: #37C1F0; box-shadow: 0 0 10px rgba(55, 193, 240,.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel { transition: none; }
    .is-active .panel-icon { animation: none; }
    .wheel-stage::before { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Desktop 3D wheel ---------- */
  const root = document.querySelector<HTMLElement>('[data-wheel]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-wheel-track]')!;
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const count = panels.length;
    const step = 360 / count;

    // Radius so panels sit comfortably apart around the circle.
    const panelW = 260;
    const radius = Math.round(panelW / 2 / Math.tan((Math.PI * step) / 360)) + 60;
    track.style.setProperty('--step', `${step}deg`);
    panels.forEach((p) => p.style.setProperty('--radius', `${radius}px`));

    let index = 0;
    let timer: number | undefined;

    const render = () => {
      gsap.to(track, {
        rotationY: -index * step,
        duration: reduce ? 0 : 1,
        ease: 'power2.out',
      });
      panels.forEach((p, k) => p.classList.toggle('is-active', k === index));
      dots.forEach((d, k) =>
        d.setAttribute('aria-selected', String(k === index))
      );
    };

    const go = (i: number) => {
      index = ((i % count) + count) % count;
      render();
    };

    const start = () => {
      if (reduce) return;
      stop();
      timer = window.setInterval(() => go(index + 1), 3400);
    };
    const stop = () => timer && window.clearInterval(timer);

    root.querySelector('[data-next]')?.addEventListener('click', () => { go(index + 1); start(); });
    root.querySelector('[data-prev]')?.addEventListener('click', () => { go(index - 1); start(); });
    dots.forEach((d) =>
      d.addEventListener('click', () => { go(Number(d.dataset.index)); start(); })
    );

    // Pause on hover / focus within
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    render();
    start();
  }

  /* ---------- Mobile Swiper ---------- */
  const mobileEl = document.querySelector('.services-swiper');
  if (mobileEl) {
    (async () => {
      const { default: Swiper } = await import('swiper');
      const { Autoplay, Pagination, EffectCoverflow, Keyboard } = await import('swiper/modules');
      await import('swiper/css');
      await import('swiper/css/effect-coverflow');
      new Swiper('.services-swiper', {
        modules: [Autoplay, Pagination, EffectCoverflow, Keyboard],
        effect: 'coverflow',
        grabCursor: true,
        centeredSlides: true,
        slidesPerView: 1.25,
        loop: true,
        keyboard: { enabled: true },
        coverflowEffect: { rotate: 0, stretch: 0, depth: 120, modifier: 2, slideShadows: false },
        autoplay: reduce ? false : { delay: 3000, disableOnInteraction: false, pauseOnMouseEnter: true },
        pagination: { el: '.services-pagination', clickable: true },
        a11y: { enabled: true },
      });
    })();
  }
</script>
