---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import { img } from '../../utils/images.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const dateStr = data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title={`${data.title} | bRIDGIN' Blog`}
  description={data.description}
  ogImage={`/og/og-default.jpg`}
  type="article"
>
  <article>
    <!-- Hero -->
    <header class="relative overflow-hidden border-b border-white/5 pb-10 pt-32 md:pt-40">
      <div class="pointer-events-none absolute inset-0 cyber-grid opacity-20"></div>
      <div class="container-x relative max-w-3xl">
        <a href="/blogs" class="reveal inline-flex items-center gap-1.5 text-sm text-cyan hover:underline">← All articles</a>
        <div class="reveal mt-4 flex flex-wrap items-center gap-3 text-xs text-white/50" data-delay="0.05">
          <span>{dateStr}</span>
          <span class="inline-flex items-center gap-1"><Icon name="clock" class="h-3.5 w-3.5" /> {data.readTime}</span>
          <span>·</span>
          <span>{data.author}</span>
        </div>
        <h1 class="reveal mt-3 text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl" data-delay="0.1">{data.title}</h1>
        <p class="reveal mt-4 text-white/65" data-delay="0.16">{data.description}</p>
        <div class="reveal mt-5 flex flex-wrap gap-2" data-delay="0.22">
          {data.tags.map((t) => (
            <span class="rounded-full border border-cyan/25 bg-cyan/5 px-3 py-0.5 text-xs text-cyan/90">{t}</span>
          ))}
        </div>
      </div>
    </header>

    <div class="container-x max-w-3xl py-10">
      <figure class="reveal m-0 overflow-hidden rounded-2xl border border-white/10" data-reveal="scale">
        <Image
          src={img(data.image)}
          alt={data.imageAlt}
          title={data.title}
          widths={[600, 1000]}
          sizes="(max-width: 768px) 100vw, 768px"
          loading="eager"
          class="aspect-[16/9] w-full object-cover"
        />
      </figure>

      <div class="blog-prose mt-10">
        <Content />
      </div>
    </div>
  </article>

  <CTASection
    headline="Enjoyed the Read? Let's Grow Your Brand."
    subline="Book a free consultation with the bRIDGIN' team today."
    secondaryLabel="Read More Articles"
    secondaryHref="/blogs"
  />
</BaseLayout>

<style is:global>
  .blog-prose { color: rgba(255, 255, 255, 0.78); font-size: 1rem; line-height: 1.75; }
  .blog-prose h2 { color: #fff; font-family: 'Space Grotesk', sans-serif; font-size: 1.6rem; font-weight: 700; margin-top: 2.4rem; margin-bottom: 0.75rem; }
  .blog-prose h3 { color: #fff; font-size: 1.25rem; font-weight: 600; margin-top: 1.8rem; margin-bottom: 0.5rem; }
  .blog-prose p { margin: 1rem 0; }
  .blog-prose a { color: #37C1F0; text-decoration: underline; text-underline-offset: 3px; }
  .blog-prose ul { list-style: none; margin: 1rem 0; padding: 0; }
  .blog-prose ul li { position: relative; padding-left: 1.5rem; margin: 0.5rem 0; }
  .blog-prose ul li::before { content: ''; position: absolute; left: 0; top: 0.6rem; width: 7px; height: 7px; border-radius: 9999px; background: #37C1F0; box-shadow: 0 0 8px rgba(55, 193, 240,0.6); }
  .blog-prose strong { color: #fff; font-weight: 600; }
  .blog-prose blockquote { border-left: 3px solid #37C1F0; background: rgba(55, 193, 240,0.05); padding: 0.75rem 1.25rem; margin: 1.5rem 0; border-radius: 0 0.5rem 0.5rem 0; color: rgba(255,255,255,0.7); font-style: italic; }
  .blog-prose em { color: rgba(255,255,255,0.85); }
</style>
