---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.js';
import { services } from '../data/services.js';

const socials = [
  { name: 'LinkedIn', href: site.socials.linkedin, icon: 'linkedin' },
  { name: 'Instagram', href: site.socials.instagram, icon: 'instagram' },
  { name: 'Facebook', href: site.socials.facebook, icon: 'facebook' },
];
---
<BaseLayout
  title="Contact Us — Get a Free Consultation | bRIDGIN' Marketing"
  description="Get in touch with bRIDGIN' Marketing Services. Call us, email us, or send a message for a free digital marketing consultation."
>
  <PageHeader
    eyebrow="Contact Us"
    title="Let's Build Your Bridge to Growth"
    subtitle="Tell us about your business and goals. We'll get back to you with a free, no-pressure consultation."
  />

  <section class="section-y bg-ink-900">
    <div class="container-x grid gap-10 lg:grid-cols-5">
      <!-- Form -->
      <div class="lg:col-span-3">
        <div class="surface top-accent p-6 sm:p-8">
          <!--
            FORM BACKEND — DECISION POINT (spec §9 / §14):
            This is a static Astro site, so the form needs a third-party
            backend. Two easy options:
              1. Formspree — set action to https://formspree.io/f/XXXX
                 and remove the JS preventDefault below.
              2. Netlify Forms — add `data-netlify="true"` + a hidden
                 `form-name` field, and deploy on Netlify.
            Until one is wired, submissions are validated client-side and
            handled by the demo handler (shows a success message only).
          -->
          <form id="contact-form" class="grid gap-5" novalidate>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-white/80">Name <span class="text-cyan">*</span></label>
                <input id="name" name="name" type="text" required autocomplete="name"
                  class="form-input" placeholder="Your full name" />
                <p class="err" data-err-for="name"></p>
              </div>
              <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-white/80">Email <span class="text-cyan">*</span></label>
                <input id="email" name="email" type="email" required autocomplete="email"
                  class="form-input" placeholder="you@example.com" />
                <p class="err" data-err-for="email"></p>
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="phone" class="mb-1.5 block text-sm font-medium text-white/80">Phone <span class="text-cyan">*</span></label>
                <input id="phone" name="phone" type="tel" required autocomplete="tel"
                  class="form-input" placeholder="+91 00000 00000" />
                <p class="err" data-err-for="phone"></p>
              </div>
              <div>
                <label for="service" class="mb-1.5 block text-sm font-medium text-white/80">Service Interested In</label>
                <select id="service" name="service" class="form-input">
                  <option value="">Select a service…</option>
                  {services.map((s) => <option value={s.name}>{s.name}</option>)}
                  <option value="Not sure yet">Not sure yet</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="mb-1.5 block text-sm font-medium text-white/80">Message <span class="text-cyan">*</span></label>
              <textarea id="message" name="message" rows="5" required
                class="form-input resize-y" placeholder="Tell us a bit about your business and what you're looking for…"></textarea>
              <p class="err" data-err-for="message"></p>
            </div>

            <div class="flex flex-wrap items-center gap-4">
              <button type="submit" class="btn-primary">
                Send Message <Icon name="arrow" class="h-4 w-4" />
              </button>
              <a href={site.phoneHref} class="btn-outline">
                <Icon name="phone" class="h-4 w-4" /> Call Now
              </a>
            </div>

            <p id="form-status" role="status" aria-live="polite" class="hidden rounded-xl border px-4 py-3 text-sm"></p>
          </form>
        </div>
      </div>

      <!-- Contact details -->
      <aside class="lg:col-span-2">
        <div class="space-y-4">
          <a href={site.phoneHref} class="surface surface-hover flex items-center gap-4 p-5">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-cyan/20 bg-cyan/10 text-cyan"><Icon name="phone" class="h-5 w-5" /></span>
            <span>
              <span class="block text-xs uppercase tracking-widest text-white/45">Call us</span>
              <span class="font-medium text-white">{site.phone}</span>
            </span>
          </a>
          <a href={`mailto:${site.email}`} class="surface surface-hover flex items-center gap-4 p-5">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-cyan/20 bg-cyan/10 text-cyan"><Icon name="mail" class="h-5 w-5" /></span>
            <span>
              <span class="block text-xs uppercase tracking-widest text-white/45">Email us</span>
              <span class="font-medium text-white">{site.email}</span>
            </span>
          </a>
          <div class="surface flex items-center gap-4 p-5">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-cyan/20 bg-cyan/10 text-cyan"><Icon name="pin" class="h-5 w-5" /></span>
            <span>
              <span class="block text-xs uppercase tracking-widest text-white/45">Visit us</span>
              <span class="font-medium text-white">{site.address}</span>
            </span>
          </div>

          <div class="surface p-5">
            <span class="block text-xs uppercase tracking-widest text-white/45">Follow us</span>
            <div class="mt-3 flex gap-3">
              {socials.map((s) => (
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`bRIDGIN' on ${s.name}`}
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white/70 transition-all hover:scale-110 hover:border-cyan hover:bg-cyan hover:text-ink-950 hover:shadow-glow">
                  <Icon name={s.icon} class="h-5 w-5" />
                </a>
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- Map -->
    <div class="container-x mt-12">
      <div class="overflow-hidden rounded-2xl border border-white/10">
        <!-- PLACEHOLDER map pin — replace src with the real location embed. -->
        <iframe
          title="bRIDGIN' Marketing Services location map (placeholder)"
          src={site.mapEmbedSrc}
          width="100%"
          height="380"
          style="border:0; filter: grayscale(0.3) invert(0.9) hue-rotate(160deg);"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .form-input {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.7rem 0.9rem;
    color: #fff;
    font-size: 0.9rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .form-input::placeholder { color: rgba(255, 255, 255, 0.35); }
  .form-input:hover { border-color: rgba(255, 255, 255, 0.22); }
  .form-input:focus {
    outline: none;
    border-color: #37C1F0;
    box-shadow: 0 0 0 3px rgba(55, 193, 240, 0.15);
  }
  select.form-input option { background: #0a0a0a; }
  .err { margin-top: 0.35rem; font-size: 0.78rem; color: #ff6b6b; min-height: 0; }
  .form-input.invalid { border-color: #ff6b6b; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;

  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const phoneRe = /^[+]?[\d\s()-]{7,}$/;

  const setError = (name: string, msg: string) => {
    const field = form?.querySelector<HTMLElement>(`[name="${name}"]`);
    const err = form?.querySelector<HTMLElement>(`[data-err-for="${name}"]`);
    if (err) err.textContent = msg;
    field?.classList.toggle('invalid', Boolean(msg));
  };

  const validate = () => {
    if (!form) return false;
    let ok = true;
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const phone = String(data.get('phone') || '').trim();
    const message = String(data.get('message') || '').trim();

    setError('name', name ? '' : 'Please enter your name.');
    setError('email', emailRe.test(email) ? '' : 'Please enter a valid email address.');
    setError('phone', phoneRe.test(phone) ? '' : 'Please enter a valid phone number.');
    setError('message', message.length >= 10 ? '' : 'Please tell us a little more (10+ characters).');

    ok = Boolean(name) && emailRe.test(email) && phoneRe.test(phone) && message.length >= 10;
    return ok;
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault(); // Remove this once a real backend (Formspree/Netlify) is wired.
    if (!status) return;
    status.classList.remove('hidden');
    if (!validate()) {
      status.className = 'rounded-xl border border-red-400/40 bg-red-400/10 px-4 py-3 text-sm text-red-300';
      status.textContent = 'Please fix the highlighted fields and try again.';
      return;
    }
    // Demo success — replace with real submission to your form backend.
    status.className = 'rounded-xl border border-cyan/40 bg-cyan/10 px-4 py-3 text-sm text-cyan';
    status.textContent = "Thanks! Your message has been validated. Connect a form backend (Formspree/Netlify) to start receiving submissions.";
    form.reset();
  });
</script>
